# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text diff=python

# Machine Learning models (Git LFS)
*.pt filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text

# Binary/Image files
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.avi binary
